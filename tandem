#!/usr/bin/env bash
# tandem — keep your own Git repositories in step across your own machines,
# with no third-party host. Each machine holds bare repositories under one
# directory; tandem replicates them peer-to-peer and syncs your working trees.
#
#   tandem sync        sync the current working repo with every machine's remote
#   tandem mirror      pull every peer's bare repos into this machine's, ff-only
#   tandem adopt       (re)point this repo's remotes at the machine it sits on
#   tandem status      what this repo (or --all, or --bares) knows, offline
#   tandem list        print this machine's bare repo names (used by mirror)
#   tandem refs        print every local bare's heads and tags (used by mirror,
#                      so a peer fetches only what moved)
#   tandem serve       SSH forced command: permit only replication (for authorized_keys)
#   tandem install     install a background timer (launchd/systemd) for `tandem mirror`
#   tandem uninstall   remove that timer
#   tandem init        write a starter config file
#
# Design: never lose unsynced work and never auto-resolve a conflict. Every
# fetch is fast-forward only; a repo whose history has diverged from a peer is
# reported and left untouched for review, never force-updated or pruned. A
# remote on the local filesystem is required (it must succeed); a remote reached
# over the network is best effort (a peer that is asleep or away is fine). That
# is what keeps a laptop useful off the network: it commits into its own bare
# repo and can restore from it fully offline.
#
# A mirror run holds one SSH connection per peer, asks the peer for its refs,
# and fetches only the repos that moved there: a quiet run fetches nothing. A
# peer line that names this machine itself is skipped, and install refuses it.
# On battery (macOS) a run waits battery_interval seconds after the last one
# began, 30 minutes by default, rather than running at the timer's every tick.
#
# Configuration lives at ${TANDEM_CONFIG:-~/.config/tandem/config}. See `tandem init`.
#
# Exit status: 0 ok, 2 misconfigured / cannot run here, 3 refused to change
# anything, 4 no remote could be reached.
set -uo pipefail

VERSION="0.4.0"

CONFIG="${TANDEM_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/tandem/config}"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/tandem"
SYNC_LOG="$STATE_DIR/sync.tsv"

# ---------------------------------------------------------------- small helpers
# Highlight outcomes only when the stream is a terminal, so timer logs and
# pipes stay plain. NO_COLOR disables color everywhere.
paint() {  # paint <fd> <ansi-color> <text>
    if [ -z "${NO_COLOR:-}" ] && [ -t "$1" ]; then
        printf '\033[%sm%s\033[0m\n' "$2" "$3"
    else
        printf '%s\n' "$3"
    fi
}
ok()   { paint 1 32 "$*"; }         # success, stdout
note() { paint 1 33 "$*"; }         # warning that belongs on stdout
warn() { paint 2 33 "$*" >&2; }     # warning on stderr
err()  { paint 2 31 "$*" >&2; }     # error on stderr

die() { local s="$1"; shift; local m; for m in "$@"; do err "$m"; done; exit "$s"; }
ts()  { date '+%F %T'; }

trim() { local v="$1"; v="${v#"${v%%[![:space:]]*}"}"; v="${v%"${v##*[![:space:]]}"}"; printf '%s' "$v"; }

expand_tilde() {
    case "$1" in
        '~')    printf '%s' "$HOME" ;;
        '~/'*)  printf '%s/%s' "$HOME" "${1#\~/}" ;;
        *)      printf '%s' "$1" ;;
    esac
}

mtime() { [ -e "$1" ] || return 0; stat -f %m "$1" 2>/dev/null || stat -c %Y "$1" 2>/dev/null || true; }

ago() {
    local t="$1" d; [ -n "$t" ] || { printf 'never'; return; }
    d=$(( $(date +%s) - t ))
    if   [ "$d" -lt 60 ];    then printf 'just now'
    elif [ "$d" -lt 3600 ];  then printf '%dm ago' $((d / 60))
    elif [ "$d" -lt 86400 ]; then printf '%dh ago' $((d / 3600))
    else printf '%dd ago' $((d / 86400)); fi
}

stamp() {
    local t="$1"; [ -n "$t" ] || { printf 'never'; return; }
    printf '%s (%s)' "$(ago "$t")" \
        "$(date -r "$t" '+%F %H:%M' 2>/dev/null || date -d "@$t" '+%F %H:%M')"
}

# Absolute path to this script even through a symlink, for launchd/authorized_keys.
resolve_self() {
    local src="${BASH_SOURCE[0]}" dir
    while [ -h "$src" ]; do
        dir="$(cd -P "$(dirname "$src")" && pwd)"; src="$(readlink "$src")"
        case "$src" in /*) ;; *) src="$dir/$src" ;; esac
    done
    printf '%s/%s\n' "$(cd -P "$(dirname "$src")" && pwd)" "$(basename "$src")"
}

# ---------------------------------------------------------------- config
MACHINE=""; BARE_DIR=""; PROJECTS_DIR=""; REMOTE_BARE_DIR=""; TIMEOUT=5
BATTERY_INTERVAL=1800
PEER_NAMES=(); PEER_HOSTS=()

load_config() {
    [ -f "$CONFIG" ] ||
        die 2 "No config at $CONFIG." 'Run `tandem init` to create one.'
    local line key val rest name
    while IFS= read -r line || [ -n "$line" ]; do
        line="${line%%#*}"; line="$(trim "$line")"
        [ -n "$line" ] || continue
        case "$line" in
            peer[[:space:]]*)
                rest="$(trim "${line#peer}")"
                name="$(trim "${rest%%=*}")"; val="$(trim "${rest#*=}")"
                [ -n "$name" ] && [ -n "$val" ] && { PEER_NAMES+=("$name"); PEER_HOSTS+=("$val"); }
                ;;
            *=*)
                key="$(trim "${line%%=*}")"; val="$(trim "${line#*=}")"
                case "$key" in
                    machine)         MACHINE="$val" ;;
                    bare_dir)        BARE_DIR="$(expand_tilde "$val")" ;;
                    projects_dir)    PROJECTS_DIR="$(expand_tilde "$val")" ;;
                    remote_bare_dir) REMOTE_BARE_DIR="$val" ;;
                    timeout)         TIMEOUT="$val" ;;
                    battery_interval) BATTERY_INTERVAL="$val" ;;
                esac
                ;;
        esac
    done < "$CONFIG"
    [ -n "$MACHINE" ] || die 2 "config: 'machine' is required in $CONFIG"
    [ -n "$BARE_DIR" ] || BARE_DIR="$HOME/GitRemotes"
    [ -n "$PROJECTS_DIR" ] || PROJECTS_DIR="$HOME/Projects"
    [ -n "$REMOTE_BARE_DIR" ] || REMOTE_BARE_DIR="$BARE_DIR"
    case "$BATTERY_INTERVAL" in
        ''|*[!0-9]*) die 2 "config: battery_interval must be a whole number of seconds (0 to disable), not '$BATTERY_INTERVAL'" ;;
    esac
}

# Every machine name, this one first.
machine_names() {
    printf '%s\n' "$MACHINE"
    local n
    for n in ${PEER_NAMES[@]+"${PEER_NAMES[@]}"}; do printf '%s\n' "$n"; done
}

host_for() {  # host_for <machine>  -> ssh host, or nothing for the local machine
    local m="$1" i
    [ "$m" = "$MACHINE" ] && return 0
    for i in ${PEER_NAMES[@]+"${!PEER_NAMES[@]}"}; do
        [ "${PEER_NAMES[$i]}" = "$m" ] && { printf '%s' "${PEER_HOSTS[$i]}"; return 0; }
    done
}

url_for() {  # url_for <machine> <barename>
    local m="$1" name="$2"
    if [ "$m" = "$MACHINE" ]; then printf '%s/%s' "$BARE_DIR" "$name"
    else printf '%s:%s/%s' "$(host_for "$m")" "$REMOTE_BARE_DIR" "$name"; fi
}

# ---------------------------------------------------------------- git helpers
require_repo() {
    git rev-parse --is-inside-work-tree >/dev/null 2>&1 ||
        die 2 'tandem must be run inside a Git working repository.'
}
has_remote() { git remote get-url "$1" >/dev/null 2>&1; }

remote_is_local() {  # a remote is local unless its URL names another host
    local url; url="$(git remote get-url "$1" 2>/dev/null)" || return 1
    case "$url" in
        file://*) return 0 ;;
        *://*)    return 1 ;;
        *:*)      case "${url%%:*}" in */*) return 0 ;; *) return 1 ;; esac ;;
        *)        return 0 ;;
    esac
}
role_of() { remote_is_local "$1" && printf 'local, required' || printf 'network, best effort'; }

ssh_command_for() {  # bounded ssh for a network remote; preserves any per-remote sshCommand
    local base; base="$(git config --get "remote.$1.sshCommand" || printf 'ssh')"
    printf '%s -o BatchMode=yes -o ConnectTimeout=%s' "$base" "$TIMEOUT"
}
git_on() {  # run a git command against a remote with the right bounds for its kind
    local rem="$1"; shift
    if remote_is_local "$rem"; then git "$@"
    else GIT_SSH_COMMAND="$(ssh_command_for "$rem")" git "$@"; fi
}

# Machine remotes present in this repo, local ones first.
configured_remotes() {
    local m
    while IFS= read -r m; do has_remote "$m" && remote_is_local "$m" && printf '%s\n' "$m"; done < <(machine_names)
    while IFS= read -r m; do has_remote "$m" && ! remote_is_local "$m" && printf '%s\n' "$m"; done < <(machine_names)
}

last_sync_epoch() {  # <repo_root> <remote>
    [ -f "$SYNC_LOG" ] || return 0
    awk -F'\t' -v r="$1" -v m="$2" '$2==r && $3==m {t=$1} END{if(t)print t}' "$SYNC_LOG"
}
record_sync() {  # <repo_root> <remote> <branch> <commit>
    mkdir -p "$STATE_DIR" 2>/dev/null || return 0
    printf '%s\t%s\t%s\t%s\t%s\n' "$(date +%s)" "$1" "$2" "$3" "$4" >> "$SYNC_LOG" 2>/dev/null || true
}

# ---------------------------------------------------------------- adopt
set_remote() {  # <name> <url>  — only ever touches the named remote
    local name="$1" url="$2" cur
    if cur="$(git remote get-url "$name" 2>/dev/null)"; then
        if [ "$cur" = "$url" ]; then printf '  %-10s unchanged  %s\n' "$name" "$url"
        else git remote set-url "$name" "$url"; printf '  %-10s %s  ->  %s\n' "$name" "$cur" "$url"; fi
    else git remote add "$name" "$url"; printf '  %-10s added      %s\n' "$name" "$url"; fi
}

looks_like_ours() {
    local m root
    while IFS= read -r m; do has_remote "$m" && return 0; done < <(machine_names)
    # Only claim a fresh repo (no remotes) under projects_dir. A repo that already
    # has an origin is hosted elsewhere — leave it for an explicit `tandem adopt`,
    # so running `tandem sync` in it never sweeps it into the mesh.
    [ -z "$(git remote 2>/dev/null)" ] || return 1
    root="$(git rev-parse --show-toplevel 2>/dev/null)" || return 1
    case "$root/" in "$PROJECTS_DIR"/*) return 0 ;; esac
    return 1
}
adopt_needed() { has_remote "$MACHINE" && remote_is_local "$MACHINE" && return 1; return 0; }

barename_here() {  # authoritative from an existing machine remote, else from path
    local root m url name=""
    while IFS= read -r m; do
        url="$(git remote get-url "$m" 2>/dev/null)" || continue
        name="$(basename "$url")"; [ -n "$name" ] && break
    done < <(machine_names)
    if [ -z "$name" ]; then
        root="$(git rev-parse --show-toplevel)"
        case "$root/" in
            "$PROJECTS_DIR"/*) name="$(printf '%s' "${root#"$PROJECTS_DIR"/}" | tr '/ ' '__' | tr -cd '[:alnum:]_.-')" ;;
            *) name="$(basename "$root")" ;;
        esac
    fi
    case "$name" in *.git) ;; *) name="$name.git" ;; esac
    printf '%s' "$name"
}

adopt_core() {
    local root name bare m
    root="$(git rev-parse --show-toplevel)"
    name="$(barename_here)"
    bare="$BARE_DIR/$name"

    printf 'Adopting %s onto %s (bare %s).\n\n' "${root/#$HOME/~}" "$MACHINE" "$name"
    if [ ! -d "$bare" ]; then
        mkdir -p "$BARE_DIR"
        git init --bare --initial-branch=main "$bare" >/dev/null
        printf '  created local bare  %s\n' "$bare"
    fi
    while IFS= read -r m; do set_remote "$m" "$(url_for "$m" "$name")"; done < <(machine_names)

    # A clone made straight from a bare leaves an `origin` duplicating one of
    # the machine remotes just set. Drop exactly that duplicate; an origin
    # pointing anywhere else (e.g. a hosting provider) is never touched.
    local ourl
    if ourl="$(git remote get-url origin 2>/dev/null)"; then
        while IFS= read -r m; do
            [ "$ourl" = "$(git remote get-url "$m" 2>/dev/null)" ] || continue
            git remote remove origin
            printf '  %-10s removed    %s (duplicate of %s)\n' origin "$ourl" "$m"
            break
        done < <(machine_names)
    fi
    printf '\n%s is %s.\n' "$MACHINE" "$(role_of "$MACHINE")"
}

cmd_adopt() { require_repo; load_config; adopt_core; printf 'Run `tandem sync` to publish and reconcile.\n'; }

# ---------------------------------------------------------------- sync
# Fast-forward onto <ref> when strictly ahead. 0 up to date/fast-forwarded,
# 1 diverged, 2 would need a clean tree. Caller decides if that is fatal.
advance_onto() {  # <ref> <label> <branch>
    local ref="$1" label="$2" branch="$3" here there
    here=$(git rev-parse HEAD); there=$(git rev-parse "$ref")
    git merge-base --is-ancestor "$there" "$here" && return 0
    git merge-base --is-ancestor "$here" "$there" || return 1
    [ -z "$(git status --porcelain --untracked-files=all)" ] || return 2
    printf 'Fast-forwarding %s from %s...\n' "$branch" "$label"
    git merge --ff-only "$ref"
}

cmd_sync() {
    require_repo; load_config

    if [ -z "${TANDEM_NO_ADOPT:-}" ] && looks_like_ours && adopt_needed; then
        note 'Remotes do not match this machine — adopting first.'
        printf '\n'
        adopt_core; printf '\n'
    fi

    local branch root rem synced=0
    local -a remotes=() live=() pushable=()
    branch=$(git symbolic-ref --quiet --short HEAD) ||
        die 2 'tandem sync requires a checked-out branch, not a detached HEAD.'
    root="$(git rev-parse --show-toplevel)"

    while IFS= read -r rem; do [ -n "$rem" ] && remotes+=("$rem"); done < <(configured_remotes)
    if [ "${#remotes[@]}" -eq 0 ]; then
        local others; others="$(git remote 2>/dev/null | tr '\n' ' ')"
        if [ -n "$others" ]; then
            die 2 "This repository is hosted elsewhere (remotes: ${others% }), not on your tandem machines." \
                  'Use `git push` to publish it, or `tandem adopt` to add it to tandem.'
        fi
        die 2 'This repository has no remotes yet.' \
              'Run `tandem adopt` to wire up your machine remotes.'
    fi

    for rem in "${remotes[@]}"; do
        printf 'Last synchronized with %-10s %s\n' "$rem:" "$(stamp "$(last_sync_epoch "$root" "$rem")")"
    done

    for rem in "${remotes[@]}"; do
        printf 'Fetching %s...\n' "$rem"
        if git_on "$rem" fetch --prune "$rem"; then live+=("$rem")
        elif remote_is_local "$rem"; then die 3 '' "The local repo for $rem could not be read." 'Nothing was changed.'
        else warn "$rem could not be reached — carrying on without it."; fi
    done

    local rc
    for rem in ${live[@]+"${live[@]}"}; do
        if ! git show-ref --verify --quiet "refs/remotes/$rem/$branch"; then pushable+=("$rem"); continue; fi
        rc=0; advance_onto "refs/remotes/$rem/$branch" "$rem" "$branch" || rc=$?
        case "$rc" in
            0) pushable+=("$rem") ;;
            1) if remote_is_local "$rem"; then die 3 '' "Local and $rem $branch have diverged. Nothing was pushed." 'Resolve the histories explicitly first.'; fi
               warn "Local and $rem $branch have diverged — skipping it." ;;
            2) if remote_is_local "$rem"; then die 3 '' "$rem $branch is ahead but this working tree is dirty." 'Commit, stash, or resolve the local work first.'; fi
               warn "$rem is ahead but this working tree is dirty — skipping it." ;;
        esac
    done

    for rem in ${pushable[@]+"${pushable[@]}"}; do
        printf 'Pushing %s to %s...\n' "$branch" "$rem"
        if git_on "$rem" push --follow-tags "$rem" "HEAD:refs/heads/$branch"; then
            record_sync "$root" "$rem" "$branch" "$(git rev-parse HEAD)"; synced=$((synced + 1))
        elif remote_is_local "$rem"; then die 3 '' "Pushing to $rem failed." 'Nothing further was attempted.'
        else warn "Pushing to $rem failed — it is not synchronized."; fi
    done

    # Track the local machine's branch when it exists.
    if remote_is_local "$MACHINE" && git show-ref --verify --quiet "refs/remotes/$MACHINE/$branch"; then
        git branch --set-upstream-to="$MACHINE/$branch" "$branch" >/dev/null 2>&1 || true
    fi

    [ "$synced" -gt 0 ] || die 4 '' 'No remote could be reached. Nothing was synchronized.' \
        'Your commits are safe locally; run `tandem sync` again when a remote is available.'
    if [ "$synced" -lt "${#remotes[@]}" ]; then note "Synchronized with $synced of ${#remotes[@]} remotes."
    else ok 'Synchronized successfully.'; fi
}

# ---------------------------------------------------------------- mirror
cmd_list() {
    [ -d "$BARE_DIR" ] || return 0
    local d; for d in "$BARE_DIR"/*.git; do [ -d "$d" ] && basename "$d"; done
}

# Every head and tag of every local bare: what a peer's mirror compares with
# its own copies, so it fetches only what moved. Each bare read is a line of
# its name alone, then one "<bare>\t<sha> <ref>" line per head and tag, so an
# empty bare is its name and nothing after it. A bare whose refs cannot be
# read is left out, and a peer fetches whatever it is not told about, so a
# gap here costs a fetch and never a skipped one. --git-dir, not -C: from a
# folder that is not a repository, -C searches upward, and a home folder kept
# as a dotfiles repository would answer for it.
REF_FORMAT='%(objectname) %(refname)'

cmd_refs() {
    local n refs line
    while IFS= read -r n; do
        refs="$(git --git-dir="$BARE_DIR/$n" for-each-ref --format="$REF_FORMAT" \
                    refs/heads refs/tags 2>/dev/null)" || continue
        printf '%s\n' "$n"
        while IFS= read -r line; do
            if [ -n "$line" ]; then printf '%s\t%s\n' "$n" "$line"; fi
        done <<< "$refs"
    done < <(cmd_list)
    return 0    # an empty bare's last test is "no line", and that is not a failure
}

# ---------------------------------------------------------------- this machine
# Whether an SSH host is this machine. A peer line naming the machine it is
# written on makes every mirror run an SSH connection to itself that can
# only fail, and nothing in the log says so: a laptop did exactly that every
# five minutes for two months. Decided without connecting: `ssh -G` reads
# the config and prints the HostName it would reach, which is compared with
# the names this machine answers to and the addresses on its interfaces
# (Tailscale's 100.x and fd7a: among them). A name that only DNS maps here
# (an /etc/hosts alias, a CNAME, a MagicDNS FQDN) is not recognised and is
# mirrored from as before: the safe direction, since taking a real peer for
# this machine would stop replication without a sound.

# The HostName ssh would connect to: lowercased, as ssh prints it, with a
# trailing dot and IPv6 brackets dropped. awk reads to the end because
# stopping at the match would SIGPIPE ssh, and pipefail counts that.
ssh_target() {
    local t
    t="$(ssh -G "$1" 2>/dev/null | awk '/^hostname / { h = $2 } END { print h }')"
    [ -n "$t" ] || t="${1##*@}"         # a config ssh cannot read: the host as given
    t="$(printf '%s' "$t" | tr '[:upper:]' '[:lower:]')"
    t="${t#\[}"; t="${t%\]}"
    printf '%s' "${t%.}"
}

local_name() { scutil --get LocalHostName 2>/dev/null || hostname -s 2>/dev/null; }

# Every name and address this machine answers to, lowercased, one to a line.
# The addresses come from ifconfig; on a system without it, only the names
# are known, and a peer given as this machine's address is mirrored from as
# before.
this_machine() {
    local n
    {
        printf 'localhost\n'
        n="$(local_name)"; [ -n "$n" ] && printf '%s\n%s.local\n' "$n" "$n"
        n="$(hostname)";   [ -n "$n" ] && printf '%s\n%s\n' "$n" "${n%.local}"
        ifconfig | awk '$1 == "inet" || $1 == "inet6" { sub(/%.*/, "", $2); print $2 }'
    } 2>/dev/null | tr '[:upper:]' '[:lower:]'
}

is_this_machine() {  # is_this_machine <host>
    local target
    target="$(ssh_target "$1")"
    [ -n "$target" ] &&
        this_machine | awk -v t="$target" '$0 == t { hit = 1 } END { exit !hit }'
}

# ---------------------------------------------------------------- battery
# On battery a mirror run waits battery_interval seconds after the last one
# began, rather than running at the timer's every interval; on mains power,
# and on a machine with no battery, nothing changes. Stretched rather than
# stopped: a laptop's bares are its travel copy, so one unplugged for an
# evening still leaves with its peers' work at most this old. A `tandem
# sync` typed by hand reaches the peers itself, whatever this says. The
# power source is read with pmset, which is macOS's: elsewhere, and
# wherever pmset is missing, this reads as mains power and the run goes
# ahead, so on Linux the timer's interval is the only one.
on_battery() {
    pmset -g batt 2>/dev/null |
        awk 'NR == 1 && /Battery Power/ { b = 1 } END { exit !b }'
}

battery_allows() {  # battery_allows <peer>: true to mirror now, else says why not
    local began="$STATE_DIR/mirror-$1.began" last age
    [ "$BATTERY_INTERVAL" -gt 0 ] || return 0
    if on_battery && [ -f "$began" ]; then
        last="$(mtime "$began")"
        age=$(( $(date +%s) - ${last:-0} ))
        # A negative age is a clock set back: mirror rather than wait it out.
        if [ "$age" -ge 0 ] && [ "$age" -lt "$BATTERY_INTERVAL" ]; then
            printf '%s %-10s on battery: the last mirror began %dm ago; the next waits for %dm.\n' \
                "$(ts)" "$1" $((age / 60)) $((BATTERY_INTERVAL / 60))
            return 1
        fi
    fi
    # A stamp that cannot be written costs the wait, not the run: the error
    # goes to the log, and the run goes ahead.
    mkdir -p "$STATE_DIR" && touch "$began"
    return 0
}

# ---------------------------------------------------------------- connection
# One SSH connection per peer per run. The probe opens it as a master, and
# the listing, the refs and every fetch ride on it as sessions; before 0.4.0
# each was a handshake of its own, one per repository, every run. The socket
# goes in a directory of this run's own under /tmp rather than $TMPDIR: a
# socket path holds 104 bytes, and $TMPDIR, %C's 40 and the 17 ssh adds
# while it binds come to more. TANDEM_CONTROL_ROOT moves it, for tests.
# ServerAlive bounds a peer that vanishes mid-run.
CONTROL_ROOT="${TANDEM_CONTROL_ROOT:-/tmp}"
SSH_OPTS=()
CONTROL_DIR=''
CONTROL_HOST=''

open_connection() {  # open_connection <host>
    CONTROL_HOST="$1"
    SSH_OPTS=(-o BatchMode=yes -o ConnectTimeout="$TIMEOUT")
    if CONTROL_DIR="$(mktemp -d "$CONTROL_ROOT/tandem.XXXXXX")"; then
        SSH_OPTS+=(-o ControlMaster=auto -o ControlPath="$CONTROL_DIR/%C"
                   -o ControlPersist=60
                   -o ServerAliveInterval=5 -o ServerAliveCountMax=3)
        trap close_connection EXIT
    else
        CONTROL_DIR=''
        warn "$(ts) No directory for a shared connection; each fetch opens its own."
    fi
    export GIT_SSH_COMMAND="ssh ${SSH_OPTS[*]}"
}

# Every master this peer's run opened (a working tree's remote may name
# another host than the peer's), then the directory that held them.
close_connection() {
    local socket
    unset GIT_SSH_COMMAND
    [ -n "$CONTROL_DIR" ] || return 0
    for socket in "$CONTROL_DIR"/*; do
        [ -S "$socket" ] &&
            ssh -o ControlPath="$socket" -O exit "$CONTROL_HOST" >/dev/null 2>&1
    done
    rm -rf "$CONTROL_DIR"
    CONTROL_DIR=''
    trap - EXIT
}

# ---------------------------------------------------------------- what moved
# The peer's heads and tags, from `tandem refs` there, so a run fetches only
# what moved; before 0.4.0 every run fetched every bare and every working
# tree's remote, changed or not. A peer that does not answer (an older
# tandem, a key restricted by an older serve, no tandem on its PATH) has
# everything fetched, as before, and the log says so. A skip needs positive
# evidence, so anything this cannot tell reads as "fetch": a repo the peer
# did not read, a line from it that is not a sha and a ref, a local read
# that failed.
PEER_REFS=''
PEER_REFS_KNOWN=0

read_peer_refs() {  # read_peer_refs <peer-name> <host>
    if PEER_REFS="$(ssh "${SSH_OPTS[@]}" "$2" 'tandem refs' 2>/dev/null)"; then
        PEER_REFS_KNOWN=1
    else
        PEER_REFS=''; PEER_REFS_KNOWN=0
        note "$(printf '%s %-10s did not answer `tandem refs`; fetching every repo.' "$(ts)" "$1")"
    fi
}

peer_read() {  # peer_read <bare>: whether the peer read it, refs or none
    printf '%s\n' "$PEER_REFS" |
        bare="$1" awk -F '\t' 'NF == 1 && $1 == ENVIRON["bare"] { hit = 1 } END { exit !hit }'
}

peer_refs_of() {  # peer_refs_of <bare>: its "<sha> <ref>" lines
    printf '%s\n' "$PEER_REFS" |
        bare="$1" awk -F '\t' 'NF == 2 && $1 == ENVIRON["bare"] { print $2 }'
}

# The refspecs a bare needs from the peer, one a line: each head or tag the
# peer has that this mirror lacks or holds at another commit. Not a head
# whose peer commit this mirror already contains: this machine is ahead
# there, and the peer takes it on its own run. Fetching that one is what git
# calls non-fast-forward, and what this reported as DIVERGED, run after run,
# until the peer caught up. Prints nothing when nothing moved, an empty bare
# there among it; fails when it cannot tell.
wanted() {  # wanted <bare> <mirror>
    local theirs ours sha ref
    [ "$PEER_REFS_KNOWN" = 1 ] || return 1
    peer_read "$1" || return 1
    theirs="$(peer_refs_of "$1")"
    ours="$(git --git-dir="$2" for-each-ref --format="$REF_FORMAT" refs/heads refs/tags)" ||
        return 1
    while read -r sha ref; do
        [ -n "$sha" ] || continue           # the one line a here-string of nothing gives
        case $'\n'"$ours"$'\n' in *$'\n'"$sha $ref"$'\n'*) continue ;; esac
        # The peer's words become a revision and a refspec here: a sha that
        # is not one, or a ref that is not a well-formed head or tag (a
        # leading + would force), and this cannot tell.
        case "$sha" in *[!0-9a-f]*) return 1 ;; esac
        [ "${#sha}" -eq 40 ] || [ "${#sha}" -eq 64 ] || return 1
        case "$ref" in refs/heads/?*|refs/tags/?*) ;; *) return 1 ;; esac
        git check-ref-format "$ref" || return 1
        case "$ref" in
            refs/heads/*)
                git --git-dir="$2" merge-base --is-ancestor "$sha" "$ref" 2>/dev/null &&
                    continue ;;
        esac
        printf '%s:%s\n' "$ref" "$ref"
    done <<< "$theirs"
}

# Whether a working tree's tracking refs for the peer are already the
# peer's. Only for a remote naming the peer's bare the way adopt writes it,
# <host>:<remote_bare_dir>/<bare>, with the default refspec; any other
# remote is fetched as before. Current means its refs/remotes/<name>/* are
# the peer's heads exactly (a fetch --prune would drop one the peer no
# longer has) and it holds every tag the peer has.
tree_current() {  # tree_current <repo> <host> <name>
    local url bare theirs ours mine='' sha ref head
    [ "$PEER_REFS_KNOWN" = 1 ] || return 1
    url="$(git -C "$1" remote get-url "$3" 2>/dev/null)" || return 1
    bare="${url#"$2:$REMOTE_BARE_DIR/"}"
    [ "$bare" != "$url" ] || return 1
    case "$bare" in *.git) ;; *) return 1 ;; esac
    case "$bare" in */*) return 1 ;; esac
    [ "$(git -C "$1" config --get-all "remote.$3.fetch")" = "+refs/heads/*:refs/remotes/$3/*" ] ||
        return 1
    peer_read "$bare" || return 1
    theirs="$(peer_refs_of "$bare")"
    ours="$(git -C "$1" for-each-ref --format="$REF_FORMAT" "refs/remotes/$3" refs/tags)" ||
        return 1
    while read -r sha ref; do
        [ -n "$sha" ] || continue
        case "$ref" in
            "refs/remotes/$3/HEAD") ;;                  # a pointer, not a branch
            "refs/remotes/$3/"*)
                head="$sha refs/heads/${ref#"refs/remotes/$3/"}"
                case $'\n'"$theirs"$'\n' in *$'\n'"$head"$'\n'*) ;; *) return 1 ;; esac
                mine+="$head"$'\n' ;;
            *)  mine+="$sha $ref"$'\n' ;;
        esac
    done <<< "$ours"
    while read -r sha ref; do
        [ -n "$sha" ] || continue
        case $'\n'"$mine" in *$'\n'"$sha $ref"$'\n'*) ;; *) return 1 ;; esac
    done <<< "$theirs"
}

# ---------------------------------------------------------------- pull
discover() {  # names of a peer's bares: tandem list, else find, else our own set
    local host="$1" names
    names="$(ssh "${SSH_OPTS[@]}" "$host" 'tandem list' 2>/dev/null)"
    [ -n "$names" ] || names="$(ssh "${SSH_OPTS[@]}" "$host" \
        "find '$REMOTE_BARE_DIR' -maxdepth 1 -type d -name '*.git' -exec basename {} \;" 2>/dev/null)"
    [ -n "$names" ] || names="$(cmd_list)"
    printf '%s\n' "$names"
}

pull_from_peer() {  # <peer-name> <host>
    local name="$1" host="$2" n mirror source err specs spec
    local updated=0 unchanged=0 created=0 failed=0
    local -a diverged=() failures=() refspecs=()

    # From this machine there is nothing to mirror: say so before any
    # connection. Status 0, as for an absent peer; the line tells them apart.
    if is_this_machine "$host"; then
        note "$(printf '%s %-10s is this machine (%s); nothing to mirror. Remove `peer %s = %s` from %s.' \
            "$(ts)" "$name" "$(local_name)" "$name" "$host" "$CONFIG")"
        return 0
    fi
    battery_allows "$name" || return 0
    open_connection "$host"

    # Reachability probe. ssh exits 255 only for its own failures (unreachable,
    # auth); any other status came from the peer, so the link is up — a
    # replication-restricted key refuses `true` yet still permits fetching.
    # Being first, it opens the connection everything after it shares.
    ssh "${SSH_OPTS[@]}" "$host" true >/dev/null 2>&1
    if [ $? -eq 255 ]; then
        note "$(printf '%s %-10s unavailable; skipped.' "$(ts)" "$name")"
        close_connection; return 0
    fi
    read_peer_refs "$name" "$host"

    # Refresh working trees' tracking refs for this peer. This only moves
    # refs/remotes/<name>/*; it never touches a working tree or a local branch.
    local gitdir repo
    while IFS= read -r gitdir; do
        repo="${gitdir%/.git}"
        git -C "$repo" remote get-url "$name" >/dev/null 2>&1 || continue
        tree_current "$repo" "$host" "$name" && continue
        git -C "$repo" fetch --prune --quiet "$name" 2>/dev/null || true
    done < <(find "$PROJECTS_DIR" -type d -name .git -print 2>/dev/null)

    mkdir -p "$BARE_DIR"
    while IFS= read -r n; do
        [ -n "$n" ] || continue; case "$n" in *.git) ;; *) continue ;; esac
        # The peer named it, and a name is one path component: a name with a
        # slash would put a bare, or a fetch, outside bare_dir.
        case "$n" in */*|.*)
            failed=$((failed + 1)); failures+=("$n: not a bare repo name, refused"); continue ;;
        esac
        mirror="$BARE_DIR/$n"; source="$host:$REMOTE_BARE_DIR/$n"
        if [ ! -d "$mirror" ]; then
            if git init --bare --initial-branch=main "$mirror" >/dev/null 2>&1; then created=$((created + 1))
            else failed=$((failed + 1)); failures+=("$n: could not make a bare here"); continue; fi
        fi
        # Only what moved on the peer, or everything when that cannot be told.
        if specs="$(wanted "$n" "$mirror")"; then
            [ -n "$specs" ] || { unchanged=$((unchanged + 1)); continue; }
        else
            specs=$'refs/heads/*:refs/heads/*\nrefs/tags/*:refs/tags/*'
        fi
        refspecs=()
        while IFS= read -r spec; do refspecs+=("$spec"); done <<< "$specs"
        # No leading + and no prune: only fast-forwards and new refs land.
        if err="$(git -C "$mirror" fetch "$source" "${refspecs[@]}" 2>&1)"; then updated=$((updated + 1))
        elif printf '%s' "$err" | grep -qiE 'rejected|non-fast-forward|forced update'; then diverged+=("$n")
        else
            failed=$((failed + 1))
            failures+=("$n: $(printf '%s\n' "$err" | awk 'NF && !line { line = $0 } END { print line }')")
        fi
    done < <(discover "$host")
    close_connection

    # Color the summary by its worst outcome: red for hard failures, yellow for
    # divergence awaiting review, green for a clean run. updated counts the
    # repos fetched, unchanged those the peer had nothing new in.
    local summary
    summary="$(printf '%s from %-10s updated=%d unchanged=%d created=%d diverged=%d failed=%d' \
        "$(ts)" "$name" "$updated" "$unchanged" "$created" "${#diverged[@]}" "$failed")"
    if   [ "$failed" -gt 0 ];         then paint 1 31 "$summary"
    elif [ "${#diverged[@]}" -gt 0 ]; then note "$summary"
    else                                   ok "$summary"
    fi
    local d
    for d in ${diverged[@]+"${diverged[@]}"}; do note "  DIVERGED — left for review, not fetched: $d"; done
    # A count alone leaves a failed repo unnamed.
    for d in ${failures[@]+"${failures[@]}"}; do paint 1 31 "  FAILED — $d"; done
    # Divergence is a state to resolve, not a run failure; only hard errors fail.
    [ "$failed" -eq 0 ]
}

cmd_mirror() {
    load_config
    local i rc=0
    [ "${#PEER_NAMES[@]}" -gt 0 ] || { printf 'No peers configured; nothing to mirror.\n'; return 0; }
    for i in "${!PEER_NAMES[@]}"; do
        pull_from_peer "${PEER_NAMES[$i]}" "${PEER_HOSTS[$i]}" || rc=1
    done
    return "$rc"
}

# ---------------------------------------------------------------- serve
# The one command a replication key may run: fetch, push, list, or refs,
# confined to a bare repo directly under BARE_DIR. Goes in authorized_keys as
# command="...".
cmd_serve() {
    load_config
    set -f
    local c="${SSH_ORIGINAL_COMMAND:-}"
    if [ "$c" = "tandem list" ]; then exec "$(resolve_self)" list; fi
    if [ "$c" = "tandem refs" ]; then exec "$(resolve_self)" refs; fi
    if [[ "$c" =~ ^(git-upload-pack|git-receive-pack)\ \'([^\']+)\'$ ]]; then
        local verb="${BASH_REMATCH[1]}" path="${BASH_REMATCH[2]}"
        case "$path" in
            "$BARE_DIR"/*.git) case "$path" in *..*) ;; *) exec "/usr/bin/$verb" "$path" ;; esac ;;
        esac
    fi
    err 'This key is restricted to Git replication.'
    exit 126
}

# ---------------------------------------------------------------- status
cmd_status() {
    load_config
    case "${1:-}" in
        --all)   status_all ;;
        --bares) status_bares ;;
        '')      status_here ;;
        *)       die 2 "Unknown option for status: $1" 'Try: tandem help' ;;
    esac
}

status_all() {
    [ -s "$SYNC_LOG" ] || { printf 'No repositories have been synchronized yet.\n'; return 0; }
    printf '%-28s %-12s %-14s %s\n' 'LAST SYNCED' 'REMOTE' 'BRANCH' 'REPOSITORY'
    awk -F'\t' '{k=$2"\t"$3; t[k]=$1; b[k]=$4} END{for(k in t) print t[k]"\t"k"\t"b[k]}' "$SYNC_LOG" |
        sort -rn | while IFS=$'\t' read -r when repo rem br; do
            [ -d "$repo" ] || repo="$repo (missing)"
            printf '%-28s %-12s %-14s %s\n' "$(stamp "$when")" "$rem" "$br" "${repo/#$HOME/~}"
        done
}

status_bares() {
    [ -d "$BARE_DIR" ] && [ -n "$(cmd_list)" ] || { printf 'No bare repos under %s yet.\n' "$BARE_DIR"; return 0; }
    printf '%-30s %s\n' 'BARE' 'NEWEST ON main'
    local name head
    while IFS= read -r name; do
        head="$(git -C "$BARE_DIR/$name" log -1 --format='%h  %cr  %s' main 2>/dev/null)"
        [ -n "$head" ] || head='(no main branch)'
        printf '%-30s %s\n' "$name" "$head"
    done < <(cmd_list)
}

status_here() {
    require_repo
    local root git_dir branch rem ref counts ahead behind found=0
    root="$(git rev-parse --show-toplevel)"; git_dir="$(git rev-parse --git-dir)"
    branch="$(git symbolic-ref --quiet --short HEAD || printf '(detached HEAD)')"
    printf 'repository   %s\n' "${root/#$HOME/~}"
    printf 'branch       %s\n' "$branch"
    printf 'last fetch   %s\n' "$(stamp "$(mtime "$git_dir/FETCH_HEAD")")"
    [ -z "$(git status --porcelain --untracked-files=all)" ] || note 'working tree has uncommitted changes'

    while IFS= read -r rem; do
        [ -n "$rem" ] || continue; found=1
        printf '\n%s (%s)\n' "$rem" "$(role_of "$rem")"
        printf '  url        %s\n' "$(git remote get-url "$rem")"
        printf '  last sync  %s\n' "$(stamp "$(last_sync_epoch "$root" "$rem")")"
        ref="refs/remotes/$rem/$branch"
        if git show-ref --verify --quiet "$ref"; then
            counts="$(git rev-list --left-right --count "HEAD...$ref")"
            ahead="$(printf '%s' "$counts" | cut -f1)"; behind="$(printf '%s' "$counts" | cut -f2)"
            if [ "$ahead" = 0 ] && [ "$behind" = 0 ]; then printf '  state      up to date as of the last fetch\n'
            else printf '  state      %s ahead, %s behind as of the last fetch\n' "$ahead" "$behind"; fi
        else printf '  state      %s/%s does not exist yet — `tandem sync` would create it\n' "$rem" "$branch"; fi
    done < <(configured_remotes)

    [ "$found" = 1 ] || printf '\nNone of these machine remotes are configured here: %s\n' "$(machine_names | tr '\n' ' ')"
    if looks_like_ours && adopt_needed; then printf '\n'; note 'note: remotes do not match this machine; `tandem sync` will adopt them first.'; fi
    printf '\nThis reflects the last fetch only; run `tandem sync` to contact the remotes.\n'
}

# ---------------------------------------------------------------- install
# The periodic `tandem mirror` job is the only platform-specific piece: launchd
# on macOS, a systemd --user timer on Linux, cron elsewhere.
plist_path()  { printf '%s/Library/LaunchAgents/local.tandem.mirror.plist' "$HOME"; }
systemd_dir() { printf '%s/systemd/user' "${XDG_CONFIG_HOME:-$HOME/.config}"; }

cmd_install() {
    load_config
    local interval="${1:-300}" i
    # A peer that is this machine can never be mirrored from; a timer naming
    # it would connect to itself every run, and nothing in its log would say so.
    for i in ${PEER_NAMES[@]+"${!PEER_NAMES[@]}"}; do
        is_this_machine "${PEER_HOSTS[$i]}" &&
            die 2 "Not installed: peer ${PEER_NAMES[$i]} = ${PEER_HOSTS[$i]} is this machine ($(local_name))." \
                  "A peer line names another machine; remove that one from $CONFIG." \
                  "This machine's work reaches the others through the timers installed there."
    done
    case "$(uname -s)" in
        Darwin) install_launchd "$interval" ;;
        Linux)  install_systemd "$interval" ;;
        *) die 2 "No automatic timer for $(uname -s)." \
               "Schedule \`$(resolve_self) mirror\` every ${interval}s with cron or your scheduler." ;;
    esac
}

cmd_uninstall() {
    case "$(uname -s)" in
        Darwin) uninstall_launchd ;;
        Linux)  uninstall_systemd ;;
        *) die 2 "No timer to remove on $(uname -s)." ;;
    esac
}

install_launchd() {
    command -v launchctl >/dev/null 2>&1 || die 2 'launchctl not found.'
    local self plist interval="$1" log
    self="$(resolve_self)"; plist="$(plist_path)"; log="$STATE_DIR/mirror.log"
    mkdir -p "$STATE_DIR" "$HOME/Library/LaunchAgents"
    cat > "$plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>local.tandem.mirror</string>
    <key>ProgramArguments</key>
    <array><string>$self</string><string>mirror</string></array>
    <key>RunAtLoad</key><true/>
    <key>StartInterval</key><integer>$interval</integer>
    <key>ProcessType</key><string>Background</string>
    <key>StandardOutPath</key><string>$log</string>
    <key>StandardErrorPath</key><string>$log</string>
</dict>
</plist>
PLIST
    launchctl unload "$plist" 2>/dev/null || true
    launchctl load "$plist"
    ok "Installed local.tandem.mirror (launchd): every ${interval}s (on battery, at most every ${BATTERY_INTERVAL}s), \`tandem mirror\`. Log: $log"
}

uninstall_launchd() {
    command -v launchctl >/dev/null 2>&1 || die 2 'launchctl not found.'
    local plist; plist="$(plist_path)"
    [ -f "$plist" ] || die 2 'No tandem mirror timer is installed.'
    launchctl unload "$plist" 2>/dev/null || true; rm -f "$plist"
    ok 'Removed local.tandem.mirror (launchd).'
}

install_systemd() {
    command -v systemctl >/dev/null 2>&1 ||
        die 2 'systemctl not found.' "Schedule \`$(resolve_self) mirror\` with cron instead."
    local self dir interval="$1"
    self="$(resolve_self)"; dir="$(systemd_dir)"
    mkdir -p "$dir"
    cat > "$dir/tandem-mirror.service" <<UNIT
[Unit]
Description=tandem mirror — replicate bare Git repos from peers

[Service]
Type=oneshot
ExecStart=$self mirror
UNIT
    cat > "$dir/tandem-mirror.timer" <<UNIT
[Unit]
Description=Run tandem mirror periodically

[Timer]
OnBootSec=1min
OnUnitActiveSec=${interval}s
Persistent=true

[Install]
WantedBy=timers.target
UNIT
    systemctl --user daemon-reload
    systemctl --user enable --now tandem-mirror.timer
    ok "Installed tandem-mirror.timer (systemd --user): every ${interval}s, \`tandem mirror\`."
    printf 'Logs: journalctl --user -u tandem-mirror. To run while logged out: loginctl enable-linger %s\n' "${USER:-$(id -un)}"
}

uninstall_systemd() {
    command -v systemctl >/dev/null 2>&1 || die 2 'systemctl not found.'
    local dir; dir="$(systemd_dir)"
    systemctl --user disable --now tandem-mirror.timer 2>/dev/null || true
    rm -f "$dir/tandem-mirror.timer" "$dir/tandem-mirror.service"
    systemctl --user daemon-reload 2>/dev/null || true
    ok 'Removed tandem-mirror.timer (systemd --user).'
}

# ---------------------------------------------------------------- init
cmd_init() {
    if [ -f "$CONFIG" ]; then printf 'Config already exists: %s\n' "$CONFIG"; return 0; fi
    mkdir -p "$(dirname "$CONFIG")"
    cat > "$CONFIG" <<'CFG'
# tandem configuration.
#
# machine       this machine's short name. It becomes the name of this machine's
#               Git remote in every repo, and the required (local) one here.
# bare_dir      where bare repositories live on this machine.
# projects_dir  where working repositories live (for tracking-ref refresh).
# timeout       seconds to wait on an unreachable peer.
# battery_interval  on battery (macOS only), seconds a mirror run waits after
#               the last one began; 0 runs at the timer's interval regardless.
# peer <name> = <ssh-host>   one line per other machine. <name> becomes that
#               machine's remote name; <ssh-host> is how to reach it over SSH.
#               Never this machine itself.

machine = this-machine
bare_dir = ~/GitRemotes
projects_dir = ~/Projects
timeout = 5
battery_interval = 1800

# peer laptop = laptop.local
# peer desktop = desktop.example.com
CFG
    ok "Wrote a starter config: $CONFIG"
    printf 'Edit it to set this machine name and your peers, then `tandem adopt` in a repo.\n'
}

usage() { awk 'NR==1 {next} /^#/ {sub(/^# ?/, ""); print; next} {exit}' "$(resolve_self)"; }

case "${1:-}" in
    sync)      cmd_sync ;;
    mirror)    cmd_mirror ;;
    adopt)     cmd_adopt ;;
    status)    shift; cmd_status "${1:-}" ;;
    list)      load_config; cmd_list ;;
    refs)      load_config; cmd_refs ;;
    serve)     cmd_serve ;;
    install)   shift; cmd_install "${1:-}" ;;
    uninstall) cmd_uninstall ;;
    init)      cmd_init ;;
    version | --version) printf 'tandem %s\n' "$VERSION" ;;
    -h | --help | help | '') usage ;;
    *) die 2 "Unknown command: $1" 'Try: tandem help' ;;
esac
